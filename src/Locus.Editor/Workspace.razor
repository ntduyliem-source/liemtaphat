@implements IAsyncDisposable
@inject FormulaWorkspace Model
@inject IEditorFiles Files
@inject IEditorClipboard Clipboard
@inject IJSRuntime Js

<div class="locus-app" data-host="@Host" data-ready="@ready.ToString().ToLowerInvariant()" data-version="@session.Version" data-view="@view" data-candidate="@session.State.CandidateId" data-busy="@session.IsBusy.ToString().ToLowerInvariant()">
    <main>
        <header class="app-header"><h1>Locus</h1><span class="host-tag">@(Host=="browser"?"Web local":"Desktop")</span>@if(DesktopWindow!=null){<div class="desktop-controls"><button id="window-size" title="@(DesktopWindow.Expanded?"Thu gọn cửa sổ":"Bung cửa sổ")" aria-label="@(DesktopWindow.Expanded?"Thu gọn cửa sổ":"Bung cửa sổ")" @onclick="DesktopWindow.ToggleSizeAsync">@(DesktopWindow.Expanded?"↙":"↗")</button><button id="window-hide" title="Ẩn về khay hệ thống" aria-label="Ẩn về khay hệ thống" @onclick="DesktopWindow.HideAsync">_</button><button id="window-exit" @onclick="DesktopWindow.ExitAsync">Thoát</button></div>}<div class="document-bar"><button id="undo" title="Hoàn tác" aria-label="Hoàn tác" disabled="@(!session.CanUndo)" @onclick="()=>History(false)">↶</button><button id="redo" title="Làm lại" aria-label="Làm lại" disabled="@(!session.CanRedo)" @onclick="()=>History(true)">↷</button><label class="file-button">Mở<InputFile id="open-document" OnChange="OpenFile" accept=".locus,.json" disabled="@session.IsComposing" /></label><button id="save-document" disabled="@(session.IsComposing||session.IsBusy)" @onclick="SaveDocument">Lưu</button></div></header>
        <div class="workspace">
            <section class="input-card"><div class="card-heading"><h2><label for="source">Nội dung</label></h2><span>Nguồn gốc</span></div>
                <div class="source-shell"><textarea id="source" @ref="sourceElement" value="@session.State.Raw" readonly="@(!ready)" spellcheck="false" placeholder="Gõ công thức hoặc dán cả đoạn…" aria-describedby="ghost-hint"></textarea><div class="source-ghost" aria-hidden="true" hidden></div><p id="ghost-hint" class="ghost-hint" role="status" hidden></p></div>
                <div class="input-foot"><span>@(session.IsComposing?"Đang ghép dấu…":session.IsBusy?"Đang đọc nội dung…":"Giữ nguyên nội dung bạn gõ")</span><span id="source-count">@session.State.Raw.Length ký tự</span></div>
                <details class="samples"><summary>Thử nhanh</summary>@foreach(var sample in samples){<button disabled="@session.IsComposing" @onclick="()=>Sample(sample)">@sample</button>}<button id="sample-paragraph" disabled="@session.IsComposing" @onclick="()=>Sample(ParagraphSample)">Đoạn Toán / Lý / Hóa</button></details>
            </section>
            <section class="result-card"><div class="card-heading"><h2>Kết quả</h2><div><button id="select-result-all" class="subtle" disabled="@(session.IsBusy||session.IsComposing||session.State.Raw.Length==0)" @onclick="SelectAllResult">Chọn tất cả</button><button id="clear-result-selection" class="subtle" disabled="@(resultSelection==null)" @onclick="ClearResultSelection">Bỏ chọn</button></div></div>
                <div id="mixed-result" class="mixed-result" @ref="resultElement" data-revision="@session.State.SourceRevision" tabindex="0" role="region" aria-label="Kết quả và công thức">
                    @if(session.State.Content is {} content && !session.IsBusy && !session.IsComposing){
                        @foreach(var block in content.Blocks()){
                            @if(block.Region is {} region){
                                <span @key="region.Id" class="result-region @(SelectedRegion(region.Id)?"is-selected":"") @(session.NextBalanceRegion==region.Id?"is-next":"")" data-region-id="@region.Id" data-source-start="@region.Start" data-source-end="@region.End">
                                    <span class="region-content" data-formula="@(region.Display!=null?"true":"false")" tabindex="0" role="button" aria-label="Chọn công thức @(content.Regions.ToList().IndexOf(region)+1)" @onclick="()=>SelectResultRegion(region.Id)">@if(region.Display is {} candidate){@((MarkupString)CandidateExporter.ToMathMl(candidate))}else{@region.Raw}</span>
                                </span>
                            }else{<span data-text-start="@block.Start" data-source-end="@block.End">@content.Raw.Substring(block.Start,block.End-block.Start)</span>}
                        }
                    }else{<span data-text-start="0" data-source-end="@session.State.Raw.Length">@session.State.Raw</span>}
                    @if(session.State.Raw.Length==0){<span class="empty-result" data-ignore-selection="true">Kết quả sẽ xuất hiện tại đây.</span>}
                </div>
                <div class="result-selection-toolbar"><p id="result-selection-status" class="selection-status" role="status">@SelectionLabel</p>
                    @if(resultSelection is { Whole.Count:1, Partial.Count:0 } && ActiveContentRegion is {} selectedRegion && SelectedRegion(selectedRegion.Id)){
                        <button id="show-region-details" class="subtle" aria-expanded="@alternatives.ToString().ToLowerInvariant()" aria-controls="formula-details" @onclick="()=>OpenRegionDetails(selectedRegion.Id)">Chi tiết công thức</button>
                    }
                </div>
                <div class="balance-toolbar" aria-label="Cân bằng phương trình">
                    <div class="balance-actions"><button id="balance-step" disabled="@(!session.CanBalanceStep)" @onclick="BalanceStep"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m4 20 12-12 4 4L8 24M13 3v4M11 5h4M21 1v4M19 3h4M21 17v4M19 19h4" transform="translate(0 -3)"/></svg>@session.BalanceStepLabel</button>
                    @if(session.SelectedReactionCount>1){<details class="balance-menu"><summary aria-label="Cân bằng tất cả trong vùng chọn">▾</summary><div><button id="balance-all" disabled="@(!session.CanBalanceBatch(false))" @onclick="()=>BalanceBatch(false)">@(session.CanQuickUndoBatch(false)?"Hoàn tác cân bằng tất cả":"Cân bằng tất cả trong vùng chọn")</button><button id="cancel-balance-all" disabled="@(!session.CanBalanceBatch(true))" @onclick="()=>BalanceBatch(true)">@(session.CanQuickUndoBatch(true)?"Hoàn tác hủy cân bằng tất cả":"Hủy cân bằng tất cả trong vùng chọn")</button></div></details>}
                    @if(session.IsBalancing){<button id="cancel-balance-work" @onclick="()=>session.CancelBalance()">Dừng xử lý</button>}</div>
                    <p id="balance-status" class="selection-status" role="status">@session.BalanceMessage</p>
                </div>
                @if(HasClippedFormula){<p class="selection-status">Chọn trọn công thức để copy kết quả.</p><button id="select-whole-formulas" @onclick="SelectWholeFormulas">Chọn trọn công thức</button>}
                @if(session.IsBusy){<button id="cancel-analysis" @onclick="CancelAnalysis">Dừng xử lý</button>}
                @if(session.Error.Length>0){<p class="notice" role="status">@session.Error</p>}
                @if(session.State.Content is {} result){@foreach(var message in result.Notices){<p class="notice" role="status">@message</p>}}
                @if(alternatives && ActiveContentRegion is {} active){
                    <div id="formula-details" class="formula-details"><div class="card-heading"><h3>Chi tiết công thức</h3><button class="subtle" @onclick="()=>alternatives=false">Đóng</button></div><label>Nguồn vùng này</label><pre>@active.Raw</pre>
                        @if(active.Problem!=null){<p>@active.Problem</p>}
                        @if(active.Readings is {} readings){<div class="candidate-list">@foreach(var choice in readings.Candidates){<button aria-pressed="@((active.Display?.Id==choice.Id).ToString().ToLowerInvariant())" @onclick="()=>Choose(choice.Id)">@((MarkupString)CandidateExporter.ToMathMl(choice))<small>@Kind(choice)</small></button>}</div>}
                        <div class="detail-actions"><button id="keep-region-text" @onclick="()=>KeepRegionText(active.Id,!active.KeepText)">@(active.KeepText?"Cho phép dựng lại công thức":"Giữ vùng này là text")</button><button @onclick="()=>EditRegionSource(active)">Sửa nguồn vùng này</button></div>
                        @if(active.Display?.Kind=="repair"){<p class="repair-note">Bạn đã chọn gợi ý sửa. Nguồn gốc vẫn được giữ.</p>}
                        @if(active.KeepFromAuto){<p>Giữ hệ số đã nhập; tự cân bằng bỏ qua vùng này cho đến khi bạn sửa công thức hoặc cân bằng có chủ đích.</p>}
                        @if(active.ResultOverride?.ManagedBalance==true){<details><summary>Trước khi cân bằng</summary>@((MarkupString)BeforeBalanceMathMl(active))</details>}
                        @if(active.ResultOverride?.ProductProposal!=null){<button id="review-drop-products" @onclick="()=>showDropProducts=!showDropProducts">Bỏ sản phẩm đã nhận…</button>@if(showDropProducts){<div class="product-restore"><p>Sẽ trả vùng kết quả về nguồn sau; các vùng khác giữ nguyên.</p><pre>@active.Raw</pre><button id="drop-products" @onclick="DropProducts">Bỏ sản phẩm đã nhận</button></div>}}
                    </div>
                }
                <div class="export-toolbar"><span id="export-scope">@ExportScopeLabel</span><div class="export-row"><button id="copy-result-text" disabled="@(!CanCopyResult)" @onclick="CopyResultText">Copy đoạn (LaTeX)</button><button id="copy-png" disabled="@(!CanExportImage)" title="Copy PNG công thức đang chọn" @onclick='()=>Export("png",true)'>▧ PNG</button><button id="copy-svg" disabled="@(!CanExportImage)" title="Copy SVG công thức đang chọn" @onclick='()=>Export("svg",true)'>◇ SVG</button><details class="download-menu"><summary>Tải</summary><button id="download-svg" disabled="@(!CanExportImage)" @onclick='()=>Export("svg")'>SVG công thức</button><button id="download-png" disabled="@(!CanExportImage)" @onclick='()=>Export("png")'>PNG công thức</button><button id="download-docx" disabled="@(!CanCopyResult||documentExporting)" @onclick='()=>ExportDocument("docx")'>DOCX với công thức Word</button><button id="download-html" disabled="@(!CanCopyResult||documentExporting)" @onclick='()=>ExportDocument("html")'>HTML với công thức</button><button id="download-source" @onclick="DownloadSource">Nguồn .txt</button></details></div></div>
                @if(CanExportImage){<details class="image-preview"><summary>Ảnh công thức đang chọn</summary><div id="formula-preview" class="formula-preview" @oncontextmenu="()=>contextMenu=true" @oncontextmenu:preventDefault data-candidate="@session.State.CandidateId" data-rendered="@((renderedSvg.Length>0).ToString().ToLowerInvariant())">@((MarkupString)renderedSvg)</div>@if(contextMenu){<div class="context-menu"><button @onclick='()=>Export("svg",true)'>Copy SVG</button><button @onclick='()=>Export("png",true)'>Copy PNG</button></div>}</details>}
            </section>
        </div>
        <div class="detection-options" role="group" aria-label="Nhận diện"><span>Nhận diện</span><label><input id="detect-math" type="checkbox" checked="@Detects(DetectionDomains.Math)" disabled="@session.IsComposing" @onchange="e=>ChangeDomains(DetectionDomains.Math,e)" /> Toán</label><label><input id="detect-physics" type="checkbox" checked="@Detects(DetectionDomains.Physics)" disabled="@session.IsComposing" @onchange="e=>ChangeDomains(DetectionDomains.Physics,e)" /> Lý</label><label><input id="detect-chemistry" type="checkbox" checked="@Detects(DetectionDomains.Chemistry)" disabled="@session.IsComposing" @onchange="e=>ChangeDomains(DetectionDomains.Chemistry,e)" /> Hóa</label></div>
        @if(notice.Length>0){<p id="notice" class="notice" role="status">@notice</p>}
        @foreach(var diagnostic in ChemistryInputNotices){<p class="assistance-note input-diagnostic" role="status">@diagnostic.Message</p>}
        <div class="auto-balance-option"><label><input id="auto-balance" type="checkbox" checked="@session.AutoBalance" disabled="@session.IsComposing" @onchange="AutoBalanceChanged" /> Tự cân bằng</label><span>Cho lần nhập hoặc dán tiếp theo</span></div>
        @if(ShowChemistryAssistance){<details class="chemistry-tools"><summary>Gợi ý sản phẩm cho công thức đơn</summary><p>Chọn điều kiện và xem toàn phương trình trước khi nhận. Nguồn gốc được giữ.</p><button id="request-assistance" disabled="@(session.IsBusy||session.IsComposing||session.IsAssisting||session.IsBalancing)" @onclick="RequestChemistryAssistance">Xem hỗ trợ Hóa</button>
            @if(session.IsAssisting){<p role="status">Đang xét phương trình…</p>}
            @if(session.Assistance is {} assistance){<div class="assistance-results" data-status="@assistance.Status"><p role="status">@assistance.Message</p>
                @if(assistance.ConditionChoices is {} conditions){<div class="chemistry-conditions">@foreach(var condition in conditions){<label>@condition.Label<select id="chemistry-condition-@condition.Key" value="@ChemistryConditionValue(condition.Key)" @onchange="args=>ChemistryConditionChanged(condition.Key,args)"><option value="">Chưa chọn</option>@foreach(var option in condition.Options){<option value="@option.Value">@option.Label</option>}</select></label>}</div>}
                @foreach(var proposal in session.AssistanceProposals){<button class="assistance-choice" data-proposal-id="@proposal.Id" @onclick="()=>AcceptChemistryAssistance(proposal.Id)">@((MarkupString)CandidateExporter.ToMathMl(proposal.Result.Candidates[0]))<small>Dùng kết quả này</small></button>}
                @if(assistance.MatchedRules is {} rules){<details><summary>Điều kiện và nguồn tham khảo</summary>@foreach(var rule in rules){<article><strong>@rule.Title</strong><p>@rule.Scope</p><p>@rule.Exclusions</p>@foreach(var link in rule.References){<a href="@link" target="_blank" rel="noopener noreferrer">Nguồn · @(new Uri(link).Host)</a>}</article>}</details>}
            </div>}
        </details>}
        @if(session.State.Transformations is {} history){<details class="assistance-history"><summary>Nguồn trước hỗ trợ</summary><pre>@history.Entries[^1].Before.Raw</pre><button id="restore-assistance-source" disabled="@(session.IsBusy||session.IsComposing)" @onclick="RestoreAssistanceSource">Khôi phục nguồn này</button></details>}
        <details class="options-panel"><summary>Tùy chọn</summary>
            <div class="mode-row"><label for="mode">Phạm vi đọc</label><select id="mode" value="@session.State.Settings.Mode.ToString()" @onchange="ChangeMode" disabled="@session.IsComposing"><option value="Explicit">Tự nhận công thức / đoạn</option><option value="Markers">Chỉ vùng có cặp bọc</option><option value="Passive">Nhận diện trong câu</option></select></div>
            <MarkerSettingsEditor Settings="session.State.Settings" Disabled="session.IsComposing" OnApply="Configure" />
            <div class="render-settings"><label>Cỡ chữ ảnh<select id="font-size" value="@view.FontSize" @onchange="FontChanged"><option value="24">24</option><option value="40">40</option><option value="64">64</option><option value="96">96</option></select></label><label>PNG<select id="pixel-scale" value="@view.PixelScale" @onchange="ScaleChanged"><option value="1">1×</option><option value="2">2×</option><option value="3">3×</option></select></label><label><input id="white-background" type="checkbox" checked="@view.WhiteBackground" @onchange="WhiteChanged" /> Nền trắng</label></div>
            <button id="copy-source" disabled="@(session.IsComposing||session.State.Raw.Length==0)" @onclick="CopyWholeSource">Copy nguồn gốc</button>
            <div class="draft-bar"><label><input id="auto-save" type="checkbox" checked="@Model.AutoSave" @onchange="AutoSaveChanged" /> Tự lưu nháp trên thiết bị</label><span id="draft-status" role="status">@Model.DraftStatus</span></div>
            <details class="drafts" @ontoggle="RefreshDrafts"><summary>Nháp gần đây</summary><p>Mỗi tab giữ một nháp riêng. Lưu tệp .locus để giữ bản sao lâu dài.</p>@foreach(var draft in drafts){<button class="draft-item" disabled="@(session.IsComposing||session.IsBusy)" @onclick="()=>OpenDraft(draft.Id)">@draft.Label</button>}</details>
            <details class="keyboard-help"><summary>Phím tắt</summary><p>Alt + I: ô nhập · Ctrl + Enter: dựng lại · Ctrl + S: lưu · Alt + 1/2/3: chọn cách đọc của vùng hiện tại · Ctrl + Z/Y: Undo/Redo. Ctrl + A ở kết quả chọn cả đoạn.</p><label><input id="accept-chemistry-space" type="checkbox" checked="@Model.AcceptChemistrySpace" @onchange="ChangeChemistrySpace" disabled="@session.IsComposing" /> Cho phép Space nhận gợi ý Hóa và thêm khoảng trắng</label></details>
            <details class="technical"><summary>Định dạng công thức đang chọn</summary><p id="session-state">Phiên @session.Version · nguồn @session.State.SourceRevision</p>@if(session.State.Candidate!=null){<pre id="latex-output">@CandidateExporter.ToLatex(session.State.Candidate)</pre><button id="copy-latex" @onclick='()=>Export("latex",true)'>Copy LaTeX</button><button id="copy-mathml" @onclick='()=>Export("mathml",true)'>Copy MathML</button><button id="copy-omml" @onclick='()=>Export("omml",true)'>Copy OMML</button><button @onclick="Snapshot">Tải snapshot</button>}</details>
            @if(capabilities.SavePicker){<button id="save-as-document" disabled="@(session.IsComposing||session.IsBusy)" @onclick="()=>SaveDocumentAs(true)">Lưu .locus vào thư mục…</button>}
        </details>
        @if(retainedFile!=null){<button id="recover-file" @onclick="RecoverOriginal">Tải lại nguyên tệp chưa mở được</button>}
        @if(fallbackFormat!=null){<button id="transfer-fallback" disabled="@(!session.CanExport)" @onclick="()=>Export(fallbackFormat)">Tải tệp @fallbackFormat.ToUpperInvariant()</button>}
        @if(Host=="browser"){<div class="app-status"><span id="offline-status">@appStatus</span>@if(updateAvailable){<button id="apply-update" disabled="@(session.IsComposing||session.IsBusy)" @onclick="UpdateApp">Lưu nháp và cập nhật</button>}</div>}
    </main>
</div>
