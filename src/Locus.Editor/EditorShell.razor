@implements IAsyncDisposable
@inject IJSRuntime Js
@inject FormulaWorkspace FormulaModel
<link rel="stylesheet" href="_content/Locus.Editor/formula.css" />
<link rel="stylesheet" href="_content/Locus.Editor/legacy.css" />
@Header?.Invoke(new(active,theme,FormulaModel.Session.CanUndo,FormulaModel.Session.CanRedo,Switch,FormulaHistory,ToggleTheme))
<div id="studio-content">
@if(active=="plot"){<div class="legacy-editors"><PlotWorkspace @ref="plotView" Host="@Host" DesktopWindow="@DesktopWindow" /></div>}
else if(active=="geometry"){<div class="legacy-editors"><GeometryWorkspace @ref="geometryView" Host="@Host" DesktopWindow="@DesktopWindow" /></div>}
else if(opened){<Workspace @ref="formulaView" Host="@Host" DesktopWindow="@DesktopWindow" />}
else{<div class="closed-tab"><h1>Phiên công thức vẫn được giữ.</h1><p>Mở lại tab để tiếp tục. Nháp được giữ trên thiết bị nếu bạn đã bật tự lưu; tệp .locus giúp giữ bản sao riêng.</p><button id="reopen-editor-tab" @onclick="()=>opened=true">Mở lại công thức</button></div>}
</div>
@code{
    [Parameter, EditorRequired] public RenderFragment<StudioShellState>? Header { get; set; }
    [Parameter] public string Host {get;set;}="browser";
    [Parameter] public Locus.Application.IEditorWindow? DesktopWindow {get;set;}
    private bool opened=true;
    private string active="formula";
    private Workspace? formulaView;
    private PlotWorkspace? plotView;
    private GeometryWorkspace? geometryView;
    private bool switching;
    private string theme="light";
    private IJSObjectReference? themeModule;
    protected override void OnInitialized()=>FormulaModel.Session.Changed+=FormulaChanged;
    private void FormulaChanged()=>_=InvokeAsync(StateHasChanged);
    private async Task FormulaHistory(bool redo){if(formulaView!=null)await formulaView.StudioHistory(redo);}
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if(!first)return;
        themeModule=await Js.InvokeAsync<IJSObjectReference>("import","./_content/Locus.DesignSystem/theme.js");
        theme=await themeModule.InvokeAsync<string>("current");StateHasChanged();
    }
    private async Task ToggleTheme()
    {
        if(themeModule!=null)theme=await themeModule.InvokeAsync<string>("apply",theme=="dark"?"light":"dark");
    }
    public async ValueTask DisposeAsync(){FormulaModel.Session.Changed-=FormulaChanged;if(themeModule!=null)try{await themeModule.DisposeAsync();}catch(JSException){}}
    private async Task<bool> CanLeave()=>active switch
    {
        "formula"=>!opened||formulaView==null||await formulaView.CanLeaveAsync(),
        "plot"=>plotView==null||await plotView.CanLeaveAsync(),
        _=>geometryView==null||await geometryView.CanLeaveAsync()
    };
    private async Task Switch(string next)
    {
        if(switching)return;switching=true;
        try{if(next==active||await CanLeave()){active=next;if(next=="formula")opened=true;}}
        finally{switching=false;}
    }
    private async Task CloseFormula(){if(await CanLeave())opened=false;}
}
