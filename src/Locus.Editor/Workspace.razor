@implements IAsyncDisposable
@inject FormulaWorkspace Model
@inject IEditorFiles Files
@inject IEditorClipboard Clipboard
@inject IJSRuntime Js

<div class="locus-app formula-studio" data-host="@Host" data-ready="@ready.ToString().ToLowerInvariant()" data-version="@session.Version" data-view="@view" data-candidate="@session.State.CandidateId" data-busy="@session.IsBusy.ToString().ToLowerInvariant()">
    <main class="studio-main">
        <section class="studio-intro">
            <h1>Natural text to <span>vector formulas</span>.</h1>
            <p>Nhập tự nhiên hoặc dán văn bản. Locus giữ nguyên cấu trúc chữ, tự động dựng Toán, Lý, Hóa.</p>
        </section>
        <FormulaDetectionBar Ready="ready" IsComposing="session.IsComposing" CanBalance="CanStudioBalance" IsBalancing="session.IsBalancing" CanDropProducts="CanDropProducts" OnDropProducts="DropProducts"
            BalanceLabel="@StudioBalanceLabel" BalanceHint="@StudioBalanceHint" IsSelected="IsDetectMode" OnDetect="SetDetectMode" OnBalance="BalanceStep" OnCancelBalance="()=>session.CancelBalance()" />
        @if(session.State.Settings.Mode==InputMode.Markers){<div class="studio-markers"><MarkerSettingsEditor Settings="session.State.Settings" Expanded="true" Disabled="session.IsComposing" OnApply="Configure" /></div>}
        <div class="workspace studio-editor-frame">
            <FormulaSourcePanel @ref="sourcePanel" Raw="@session.State.Raw" Ready="ready" IsBusy="session.IsBusy" IsComposing="session.IsComposing" WordCount="WordCount" OnClear='()=>Sample("")' />
        <section class="result-card" aria-labelledby="result-title">
                <div class="card-heading"><h2 id="result-title"><span class="section-dot result-dot" aria-hidden="true"></span>Kết quả biên dịch</h2><span class="studio-result-status" role="status">@ResultStatus</span></div>
                <FormulaResult @ref="resultPanel" Content="session.State.Content" Raw="@session.State.Raw" Revision="session.State.SourceRevision" IsBusy="session.IsBusy" IsComposing="session.IsComposing" WholeDocumentSelected="WholeArticleSelected" SelectedIds="resultSelection?.Whole" OnSelect="SelectResultRegion" />
        <FormulaSuggestions SelectedRegion="SuggestionRegion"
                    IsComposing="session.IsComposing" IsBusy="session.IsBusy" OnChoose="ChooseSuggestion"
                    OnKeepText="()=>KeepSuggestionText(SuggestionRegion!.Id,!SuggestionRegion.KeepText)" />
        </section>
        </div>
        <FormulaExportBar ScopeLabel="@ExportScopeLabel" AllSelected="WholeArticleSelected" IsBusy="session.IsBusy" IsComposing="session.IsComposing" IsEmpty="@(session.State.Raw.Length==0)"
            IsExporting="imageExporting" CanExportImage="CanExportImage" OnSelectAll="SelectAllResult" OnImage="ExportResultImage" />
        <div class="studio-feedback">
            @if(session.BalanceMessage.Length>0){<p id="balance-status" class="selection-status" role="status">@session.BalanceMessage</p>}
            @if(resultSelection?.Partial.Count>0){<p class="selection-status">Chọn trọn công thức để cân bằng hoặc xuất ảnh.</p>}
                @if(session.IsBusy){<StudioButton id="cancel-analysis" OnClick="CancelAnalysis">Dừng xử lý</StudioButton>}
                @if(session.Error.Length>0){<p class="notice" role="status">@session.Error</p>}
                @if(session.State.Content is {} result){@foreach(var message in result.Notices){<p class="notice" role="status">@message</p>}}<StudioNotice Message="@notice" Revision="@noticeRevision" />
        @foreach(var diagnostic in ChemistryInputNotices){<p class="assistance-note input-diagnostic" role="status">@diagnostic.Message</p>}
        </div>
        @if(ShowChemistryAssistance && (session.Assistance!=null || session.State.Raw.TrimEnd().EndsWith("="))){<div class="studio-chemistry-context">@if(ShowChemistryAssistance){<details class="chemistry-tools"><summary>Gợi ý sản phẩm cho công thức đơn</summary><p>Chọn điều kiện và xem toàn phương trình trước khi nhận. Nguồn gốc được giữ.</p><StudioButton id="request-assistance" Disabled="@(session.IsBusy||session.IsComposing||session.IsAssisting||session.IsBalancing)" OnClick="RequestChemistryAssistance">Xem hỗ trợ Hóa</StudioButton>
            @if(session.IsAssisting){<p role="status">Đang xét phương trình…</p>}
            @if(session.Assistance is {} assistance){<div class="assistance-results" data-status="@assistance.Status"><p role="status">@assistance.Message</p>
                @if(assistance.ConditionChoices is {} conditions){<div class="chemistry-conditions">@foreach(var condition in conditions){<label>@condition.Label<StudioSelect id="@($"chemistry-condition-{condition.Key}")" value="@ChemistryConditionValue(condition.Key)" OnChange="args=>ChemistryConditionChanged(condition.Key,args)"><option value="">Chưa chọn</option>@foreach(var option in condition.Options){<option value="@option.Value">@option.Label</option>}</StudioSelect></label>}</div>}
                @foreach(var proposal in session.AssistanceProposals){<StudioButton Class="assistance-choice" data-proposal-id="@proposal.Id" OnClick="()=>AcceptChemistryAssistance(proposal.Id)">@((MarkupString)CandidateExporter.ToMathMl(proposal.Result.Candidates[0]))<small>Dùng kết quả này</small></StudioButton>}
                @if(assistance.MatchedRules is {} rules){<details><summary>Điều kiện và nguồn tham khảo</summary>@foreach(var rule in rules){<article><strong>@rule.Title</strong><p>@rule.Scope</p><p>@rule.Exclusions</p>@foreach(var link in rule.References){<a href="@link" target="_blank" rel="noopener noreferrer">Nguồn · @(new Uri(link).Host)</a>}</article>}</details>}
            </div>}
        </details>}</div>}
        @if(retainedFile!=null){<StudioButton id="recover-file" OnClick="RecoverOriginal">Tải lại nguyên tệp chưa mở được</StudioButton>}
        <footer class="studio-footer"><span><span class="section-dot" aria-hidden="true"></span>LOCUS° — Fast Vector Scientific Typesetting</span>@if(Host=="browser"){<span id="offline-status">@appStatus</span>@if(updateAvailable){<StudioButton id="apply-update" Disabled="@(session.IsComposing||session.IsBusy)" OnClick="UpdateApp">Cập nhật</StudioButton>}}</footer>
    </main>
</div>
