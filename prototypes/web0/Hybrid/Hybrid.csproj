    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework><OutputType>WinExe</OutputType><UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Locus.WebProbe.Hybrid</RootNamespace><AssemblyName>Locus.WebProbe.Hybrid</AssemblyName><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
