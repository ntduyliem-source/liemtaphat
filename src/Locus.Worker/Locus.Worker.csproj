<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><OutputType>Exe</OutputType><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeFrameworkVersion>10.0.11</RuntimeFrameworkVersion><WasmBuildNative>false</WasmBuildNative>
    <InvariantGlobalization>false</InvariantGlobalization><WasmIncludeFullIcuData>true</WasmIncludeFullIcuData>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Locus.Application/Locus.Application.csproj" /><TrimmerRootAssembly Include="Locus.Core" /><TrimmerRootAssembly Include="Locus.Application" /></ItemGroup>
</Project>
